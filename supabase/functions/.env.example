# Secret delle Edge Functions. Copiare in supabase/functions/.env per lo
# sviluppo locale (`supabase functions serve --env-file supabase/functions/.env`).
#
# .env è IGNORATO da git. Questi valori NON devono mai finire nel bundle client:
# vivono solo qui e, in cloud, come secret del progetto Supabase
# (`supabase secrets set --env-file ...`).
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY sono iniettate automaticamente dal
# runtime: non serve dichiararle.

# Chiave Anthropic — usata dalla funzione `narrative` (narrazione unificata).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Chiave OpenAI — serve SOLO per `transcribe`: Anthropic non offre né
# trascrizione audio (Whisper) né embedding. Lasciare vuoto disattiva la
# trascrizione automatica; la narrazione funziona comunque.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Bucket dello Storage con gli audio dei contributi.
SENTI_AUDIO_BUCKET=audio

# URL pubblico del sito, usato dalla funzione `share` per il link "Apri in Senti".
# In locale si può lasciare vuoto.
SENTI_SITE_URL=

# URL PUBBLICO delle Edge Functions. IMPORTANTE per `share`: dentro il container
# req.url è l'indirizzo interno, inutilizzabile in og:image (WhatsApp non
# riuscirebbe a scaricare l'anteprima). Impostarlo sempre in produzione.
#   produzione: https://<ref-progetto>.supabase.co/functions/v1
#   locale:     http://127.0.0.1:54321/functions/v1
SENTI_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
