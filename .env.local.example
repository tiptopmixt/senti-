# Copia questo file in .env.local e compila i valori.
# .env.local è IGNORATO da git: non deve mai finire in un commit.
#
# ATTENZIONE: qui vanno SOLO variabili pubbliche (NEXT_PUBLIC_*), che finiscono
# nel bundle client. OPENAI_API_KEY e SUPABASE_SERVICE_ROLE_KEY NON vanno qui:
# esistono solo come secret delle Supabase Edge Functions.

# URL e anon key del progetto Supabase (di SVILUPPO in locale).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Modalità demo: mostra il selettore utenti (Anna/Marco/Curatrice) e il seed.
# In produzione va tenuta spenta (false) o assente.
NEXT_PUBLIC_DEMO=true

# Sottocartella per GitHub Pages (project page). In locale lasciare vuoto.
NEXT_PUBLIC_BASE_PATH=
